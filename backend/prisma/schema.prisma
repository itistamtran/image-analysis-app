generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String
  role               Role
  createdAt          DateTime           @default(now())
  verificationStatus VerificationStatus @default(PENDING)
  licenseNumber      String?            @unique

  predictions Prediction[]
  reports     Report[]     @relation("DoctorReports")
  Log         Log[]

  // Doctor can have many patients
  doctorPatients Patient[] @relation("DoctorPatients")

  // Patient user may be linked to one Patient profile
  patientAccount Patient[] @relation("PatientAccount")

  @@index([role])
  @@index([verificationStatus])
}

model HospitalDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model Prediction {
  id        String   @id @default(cuid())
  result    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  reports Report[]
}

model Report {
  id        String   @id @default(cuid())
  notes     String
  createdAt DateTime @default(now())

  prediction   Prediction @relation(fields: [predictionId], references: [id])
  predictionId String

  doctor   User   @relation("DoctorReports", fields: [doctorId], references: [id])
  doctorId String
}

model Log {
  id        String   @id @default(cuid())
  message   String
  level     LogLevel
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model Patient {
  id              Int      @id @default(autoincrement())
  patient_name    String
  email           String
  age             Int?
  gender          String?
  medical_history String?

  doctor_id       String?
  linked_user_id  String?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  doctor      User? @relation("DoctorPatients", fields: [doctor_id], references: [id])
  linkedUser  User? @relation("PatientAccount", fields: [linked_user_id], references: [id])
}

